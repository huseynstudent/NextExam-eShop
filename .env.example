# Copy this file to .env and fill in the values below.

# --- Database (Prisma) ---------------------------------------------------
# SQLite, zero setup — a dev.db file appears next to this one after
# `npm run db:push`. Swap to a Postgres/MySQL URL for production and
# update the `provider` in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# --- Auth.js ---------------------------------------------------------------
# Any random string works — generate one with: openssl rand -base64 32
AUTH_SECRET=""

# From Google Cloud Console → APIs & Services → Credentials →
# Create Credentials → OAuth client ID (type: Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Admin allowlist ---------------------------------------------------------
# Comma-separated Google account emails. Anyone who signs in at /admin/login
# with one of these addresses is automatically promoted to role=ADMIN.
ADMIN_EMAILS="you@gmail.com"
